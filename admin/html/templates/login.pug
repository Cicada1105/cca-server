//-
	This file inherits from the base template
extends control_panel/page_template.pug

//- Call init function for current music, appending to included script
//-block append scripts
	script
		- begin.initEditingListeners();

//- Define styles to include, appending to included global style
block append styles
	style
		include ../styling/login.css

block mixins

//- Define location
block location
	h3!= "&ndash; &nbsp;&nbsp;&nbsp;Login&nbsp;&nbsp;&nbsp; &ndash;"

//- Define page content
block page_content
	section.card
		- let SERVER_URL = process.env.ENVIRONMENT === 'dev' ? `${process.env.SERVER_URL}:${process.env.PORT}` : process.env.SERVER_URL;
		form#login(action=`${SERVER_URL}/cca-admin-login` method="POST" enctype="application/json")
			div.inputCont
				input(type="text" name="username" placeholder="Username..." autocomplete="username" required)
				span(id="userErrMsg") * #{userErrMsg}
			div.inputCont
				input(type="password" name="password" placeholder="Password..." autocomplete="current-password" required)
				span(id="passErrMsg") * #{passErrMsg}
			input(type="submit" value="Login")